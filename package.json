{
  "name": "outfits",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db": "mongod --dbpath data/mongo --bind_ip 127.0.0.1",
    "dev": "concurrently -n api,web \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "test": "node --import tsx --test shared/pairings.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@imgly/background-removal-node": "^1.4.5",
    "express": "^5.3.0",
    "mongodb": "^7.7.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
