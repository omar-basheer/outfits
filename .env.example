MONGODB_URI=mongodb://localhost:27017/outfits
# Leave empty to tag items by hand; set it to auto-tag from photos.
ANTHROPIC_API_KEY=
PORT=3000

# Production only (the server refuses to start in production without the first two):
# APP_PASSWORD=choose-a-long-password
# PHOTO_DIR=/data/photos   # a mounted Railway volume
# MONGODB_DB=outfits
# TZ=Africa/Accra          # so "today" matches your clock
